QSplitter::handle {
    background: transparent;
}
QTabWidget#libraryTabs::pane,
QWidget#libraryPage {
    background: transparent;
    border: 0;
}
QTabWidget#libraryTabs QTabBar::tab {
    background: rgba(249, 232, 255, 22);
    border: 1px solid rgba(249, 232, 255, 14);
    color: #e5dce9;
}
QTabWidget#libraryTabs QTabBar::tab:hover {
    background: rgba(249, 232, 255, 37);
}
QTabWidget#libraryTabs QTabBar::tab:selected {
    background: rgba(231, 211, 255, 58);
    border-color: rgba(239, 221, 255, 29);
    color: #fff8ff;
}
QTabWidget#libraryTabs QPushButton,
QTabWidget#libraryTabs QToolButton {
    background: rgba(242, 224, 255, 24);
    border: 1px solid rgba(245, 225, 255, 16);
}
QTabWidget#libraryTabs QPushButton:hover,
QTabWidget#libraryTabs QToolButton:hover {
    background: rgba(242, 224, 255, 42);
}
QTabWidget#libraryTabs QPushButton#primaryAction {
    background: #dbcbff;
    color: #2d1949;
}
QTabWidget#libraryTabs QPushButton#primaryAction:hover {
    background: #e8dcff;
}
QTabWidget#libraryTabs QLineEdit,
QTabWidget#libraryTabs QComboBox,
QTabWidget#libraryTabs QDoubleSpinBox,
QTabWidget#libraryTabs QSpinBox {
    background: rgba(21, 15, 27, 70);
    border: 1px solid rgba(244, 223, 255, 38);
}
QTabWidget#libraryTabs QLineEdit:focus,
QTabWidget#libraryTabs QComboBox:focus,
QTabWidget#libraryTabs QDoubleSpinBox:focus,
QTabWidget#libraryTabs QSpinBox:focus {
    border-color: rgba(228, 197, 255, 175);
}
QTabWidget#libraryTabs QListWidget#lyricLines::item:selected {
    background: rgba(242, 224, 255, 24);
}
